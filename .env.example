# Vision + frontier LLM calls (Anthropic Claude by default)
ANTHROPIC_API_KEY=

# Model used for vision/text food identification
VISION_MODEL=claude-sonnet-4-6

# Once you've deployed modal_services/nutrition_specialist.py, put the
# resulting endpoint URL here. Leave blank to use the heuristic fallback.
MODAL_SPECIALIST_URL=

# Where the RAG vectorstore lives (built by data/build_vectorstore.py)
VECTORSTORE_DIR=./vectorstore

# Where the meal log / goals get persisted
MEMORY_PATH=./memory.json
